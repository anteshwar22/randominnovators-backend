# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/edupulse

# Admin secret used by the requireAdmin middleware.
# Send it back as either:
#   Authorization: Bearer <ADMIN_SECRET_KEY>
#   x-admin-key: <ADMIN_SECRET_KEY>
ADMIN_SECRET_KEY=change_this_to_a_long_random_string

# ImageKit.io credentials (optional — leave blank to disable image upload)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
