# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=

# Admin secret used by the requireAdmin middleware
ADMIN_SECRET_KEY=

# Frontend URL for CORS
FRONTEND_URL=https://randominnovators.vercel.app

# ImageKit.io credentials (optional — leave blank to disable image upload)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
